# Server
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Auth
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_JWT_SECRET=replace_with_a_long_random_admin_secret
SUPPORT_JWT_SECRET=replace_with_a_long_random_support_secret
MERCHANT_JWT_SECRET=replace_with_a_long_random_merchant_token_secret

# Merchant Token Auth
MERCHANT_ACCESS_TOKEN_TTL_SECONDS=7200
MERCHANT_TOKEN_ISSUANCE_WINDOW_MS=3600000
MERCHANT_TOKEN_ISSUANCE_MAX=2

# Encryption
ENCRYPTION_KEY=replace_with_a_64_char_hex_key
TWO_FACTOR_ENCRYPTION_KEY=replace_with_a_long_random_2fa_secret
TWO_FACTOR_ISSUER=Gameket

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payments
GAMEKET_PAY_API_KEY=your_gameket_pay_api_key

# Images
IMGBB_API_KEY=your_imgbb_api_key

# Email / SMTP
SMTP_EMAIL=noreply@example.com
SMTP_PASSWORD=your_smtp_password
ADMIN_EMAIL=admin@example.com
EMAIL_KEY=replace_with_admin_test_email_key
CONFIRM_EMAIL_URL=https://shop.gameket.io/auth/confirm-email
